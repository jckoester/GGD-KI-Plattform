# Datenbankpasswort: openssl rand -base64 32
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@localhost:5432/ggd_ki

# Integrationstests (separate Test-DB mit pgvector)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@localhost:5432/ggd_ki_test
# SCHOOL_SECRET (HMAC-Pseudonymisierung) und JWT_SECRET (Auth-Cookie-Signatur): in PRODUKTION
# je ein starker Zufallswert ≥ 32 Zeichen (`openssl rand -base64 32`). Platzhalter/leer/zu kurz
# werden beim Start abgelehnt (ENVIRONMENT != development). Lokal dürfen kurze Test-Werte stehen.
SCHOOL_SECRET=           # openssl rand -base64 32
JWT_SECRET=              # openssl rand -base64 32
# LiteLLM-Proxy. Lokal läuft er als Prozess in der backend-venv auf Port 4000
# (siehe docs/dev/dev-setup.md → "LiteLLM lokal starten"), in Produktion im Netz.
LITELLM_PROXY_URL=http://localhost:4000
# Voller Zugriff auf den LiteLLM-Proxy (Key-Minting, Budgets). In PRODUKTION zwingend ein
# starker Zufallswert ≥ 20 Zeichen (`openssl rand -base64 32`); Platzhalter/leer werden beim
# Start abgelehnt (ENVIRONMENT != development). Lokal darf ein schwacher Dev-Key stehen.
# Muss mit master_key in der LiteLLM-Config übereinstimmen.
LITELLM_MASTER_KEY=
# ── Provider-Zugänge ────────────────────────────────────────────────────────────────
# Nur der LiteLLM-Proxy braucht diese Schlüssel — das Backend ruft NIE direkt einen
# Anbieter auf. Es genügen die Zugänge der Anbieter, die in der LiteLLM-Config tatsächlich
# vorkommen; nicht genutzte Zeilen leer lassen.
OPENAI_API_KEY=
# EU-Anbieter (IONOS AI Model Hub) — OpenAI-kompatibel, daher als `openai/<id>` plus
# eigener api_base in der LiteLLM-Config eingetragen. Siehe ADR-015.
# Token im IONOS Data Center Designer erzeugen (Token Manager).
# Welche Modell-IDs der Katalog führt, zeigt `python scripts/ionos_probe.py`.
IONOS_API_KEY=
IONOS_API_BASE=https://openai.inference.de-txl.ionos.com/v1
# Self-hosted Fallback via Ollama (Pflicht-Fallback laut Projektvorgabe).
OLLAMA_BASE_URL=http://localhost:11434
# SEPARATE Postgres-DB NUR für den LiteLLM-Proxy (Virtual Keys, Teams, Budgets, SpendLogs).
# Plain postgresql:// (NICHT der asyncpg-DSN von DATABASE_URL) und eigene DB, damit LiteLLMs
# Prisma-Schema nicht mit dem Alembic-Schema der App kollidiert.
LITELLM_DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/litellm
# Login der LiteLLM-Admin-UI (http://localhost:4000/ui). Optional: ohne diese Vars ist der
# Login Username `admin` + Passwort = LITELLM_MASTER_KEY. Betrifft NUR die Proxy-UI, nicht
# das GGD-KI-Frontend (das läuft über den yaml_test-Adapter / IServ).
UI_USERNAME=admin
UI_PASSWORD=
# Verschlüsselt die in der DB gespeicherten Credential-api_keys (store_model_in_db).
# Optional; ohne Wert wird LITELLM_MASTER_KEY genutzt. Fest setzen, damit ein späterer
# Master-Key-Wechsel gespeicherte Credentials nicht unentschlüsselbar macht.
LITELLM_SALT_KEY=
# ── Chat-Modelle ────────────────────────────────────────────────────────────────────
# Die Werte sind die `model_name`s aus der LiteLLM-Config — NICHT die Modell-IDs der
# Anbieter. Sprechende Namen (chat-standard, chat-schnell …) statt Produktnamen halten
# einen späteren Anbieterwechsel auf eine Zeile in der Proxy-Config beschränkt.
# Ohne CHAT_DEFAULT_MODEL schlagen Chats ohne ausdrückliche Modellwahl fehl (Hinweis im
# Startup-Log). Für Werkzeuge (Wissensgraph, Planung, Bilder) muss das Modell
# Function-Calling beherrschen.
CHAT_DEFAULT_MODEL=
# Modell für die automatischen Gesprächstitel — klein und günstig genügt.
# Leer = keine Titelgenerierung. Muss in JEDER Team-Allowlist freigeschaltet sein, weil der
# Aufruf über den persönlichen Virtual Key der Nutzer:innen läuft.
TITLE_MODEL=
# Modelle mit diesen Präfixen erscheinen NICHT im Chat-Modellwähler: interne Modelle
# (Titel, Moderation) und andere Modalitäten. Rein kosmetisch — Freigaben bleiben
# unberührt, TITLE_MODEL muss weiterhin in der Team-Allowlist stehen.
# ⚠️ Die Präfixe müssen zu den `model_name`s in der LiteLLM-Config passen. Wer dort noch
# rohe Anbieternamen führt (text-embedding-3-small, gpt-image-1 …), greift entweder auf die
# empfohlenen sprechenden Namen um oder ergänzt die eigenen Präfixe hier.
MODEL_PICKER_HIDDEN_PREFIXES=["system-","embedding-","bild-"]
# ── Embedding-Modell (Kontextspeicher / semantische Suche) ──────────────────────────
# Alle Werte sind die Namen, unter denen der LiteLLM-Proxy die Modelle führt — NICHT die
# Anbieter-IDs. Leer lassen = die unten dokumentierten Defaults aus app/config.py.
# Default entspricht dem bisherigen Stand (OpenAI text-embedding-3-small, 1536 Dim.).
EMBEDDING_MODEL=text-embedding-3-small
# ⚠️ EMBEDDING_DIMENSIONS ist KEIN reiner Schalter: Der Wert muss zur Spaltenbreite von
# context_nodes.embedding passen. Ändern heißt Migration + vollständiges Re-Embedding
# aller Knoten (Vektoren verschiedener Modelle sind nicht vergleichbar).
# Siehe docs/runbooks/modellwechsel.md. BGE-M3 (IONOS) hätte z. B. 1024.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MAX_CHARS=16000   # Zeichen-Cap vor dem Call (Token-Limit des Modells, konservativ)
# `dimensions`-Parameter mitsenden — nur für Modelle, die das Kürzen unterstützen
# (OpenAI text-embedding-3-*). BGE-M3 und die meisten offenen Modelle lehnen ihn ab.
EMBEDDING_SEND_DIMENSIONS=false
# Texte pro Embedding-Anfrage im Stapelbetrieb (Backfill, Import). Einzeln angelegte Knoten
# gehen weiterhin allein raus. Der Hebel ist groß: Ein Aufruf je Knoten macht aus dem
# Re-Embedding eines vollständigen Bildungsplans einen mehrstündigen Lauf.
EMBEDDING_BATCH_SIZE=64
# Obergrenze für den Tokendurchsatz im Stapelbetrieb; 0 = keine Drosselung. Getaktet wird
# nach dem tatsächlich abgerechneten Verbrauch (`usage.total_tokens`).
# 3000/s ≈ 180.000 Tokens/Minute — vorsichtig genug für kleine Kontingente. Wer Luft hat,
# setzt den Wert hoch oder auf 0; ohne Drosselung sind es grob 300.000 Tokens/Minute.
# Das passende Tempo steht im Rate-Limit des eigenen Anbieterkontos.
EMBEDDING_TOKENS_PER_SECOND=3000
# Wiederholversuche bei 429 (Rate-Limit) und 503. Ein Rate-Limit ist vorübergehend —
# ohne Wiederholung bekommt der Knoten einen dauerhaften `embedding_error` und fehlt bis
# zum nächsten Backfill in der semantischen Suche. Spürbar nach einem Bildungsplan-Import:
# Der nächtliche Backfill bettet dann Tausende Knoten am Stück ein. 0 = nicht wiederholen.
EMBEDDING_MAX_RETRIES=3
# Obergrenze je Wartezeit (Sekunden). Deckelt auch ein großzügiges `Retry-After` des
# Anbieters — beim Anlegen eines Knotens läuft die Einbettung inline im Request.
EMBEDDING_RETRY_MAX_WAIT_S=5.0
# ── Bildgenerierung ─────────────────────────────────────────────────────────────────
IMAGE_DEFAULT_MODEL=gpt-image-1     # Name laut LiteLLM-Config (mit model_info.mode: image_generation)
IMAGE_GENERATION_TIMEOUT=120.0
# response_format für /images/generations:
#   b64_json = Base64 erzwingen — nötig für Modelle, die sonst eine extern gehostete URL
#              liefern (FLUX, SDXL). Solche URLs verarbeitet das Backend bewusst NICHT.
#   (leer)   = Parameter weglassen — für Modelle, die ihn ablehnen (gpt-image-1).
IMAGE_RESPONSE_FORMAT=
# Benannte Bildformate: Name → Pixelgröße, als JSON-Objekt. Der Name ist das, was das Modell
# im generate_image-Tool wählt; die Pixelgröße geht an den Provider. Ein Anbieterwechsel
# ändert nur die rechte Seite. Zusätzliche Formate sind erlaubt (z. B. "panorama" fürs
# Tafelbild) — das Tool-Schema und die Beschreibung entstehen automatisch daraus.
# ⚠️ Nur Größen eintragen, für die in der LiteLLM-Config ein Preis hinterlegt ist: sonst
# bleibt der Spend bei 0 und Budgets/Kostenstatistik greifen nicht. Die Defaults unten sind
# gpt-image-1-Größen; SDXL/FLUX kennen andere (z. B. 1152x896, 1344x768).
IMAGE_SIZES={"quadratisch":"1024x1024","hoch":"1024x1536","quer":"1536x1024"}
IMAGE_DEFAULT_FORMAT=quadratisch    # muss ein Schlüssel aus IMAGE_SIZES sein (wird beim Start geprüft)
# Bildpreise für LiteLLMs Kostentabelle: Modell-ID beim Anbieter (OHNE Provider-Präfix)
# → Preis je Bild in USD. Nötig, weil LiteLLM für BILDER das `model_info` der Config
# ignoriert und nur seine eingebaute Preistabelle liest — selbst eingetragene Bildmodelle
# kosten sonst 0,00 $ und laufen am EUR-Budget vorbei, ohne Fehlermeldung.
# Eingehängt über den Callback `guardrails.bildpreise.registrierung` in der LiteLLM-Config.
# ⚠️ In EINFACHE Anführungszeichen setzen! Das Proxy-Startskript `source`t die .env, und
# die Shell entfernt sonst die inneren Anführungszeichen — aus dem JSON würde Unsinn.
# Kostet ein Modell je Format verschieden, muss der Schlüssel die Größe tragen:
# '{"1024-x-1024/FLUX.2-klein-4B":0.014,"1024-x-1536/FLUX.2-klein-4B":0.021}'
IMAGE_PRICES='{"black-forest-labs/FLUX.1-schnell":0.032}'
# ── Jugendschutz-Klassifikator ──────────────────────────────────────────────────────
# Zählerstand des Guardrails, ausgeliefert unter /api/admin/guardrail/health.
# ⚠️ Muss auf DIESELBE Datei zeigen wie `health_file` in der LiteLLM-Config — der Proxy
# schreibt sie, das Backend liest sie. In Docker also ein gemeinsam gemountetes
# Verzeichnis. Relative Pfade werden am Repo-Root verankert, nicht am Arbeitsverzeichnis.
# Fehlt die Datei, meldet der Endpunkt „kein Bericht" — das ist NICHT „alles in Ordnung".
GUARDRAIL_HEALTH_FILE=data/guardrail_health.json
# Ab diesem Alter gilt der Bericht als veraltet und NICHT mehr als gesund. Schützt gegen
# den gefährlichsten Zustand: Ein gestoppter Proxy hinterlässt eine Datei mit
# `healthy: true`, die sonst unbegrenzt Entwarnung gäbe.
GUARDRAIL_HEALTH_MAX_AGE_H=24
SPEND_LOG_DELAY=1.0        # Sekunden Wartezeit nach Stream-Ende vor SpendLogs-Abfrage (Default: 1.0)
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
NGINX_PORT=80                # Host-Port für nginx (Default 80; z.B. 8080 hinter vorgelagertem Reverse-Proxy)
# Host-Header-Allowlist (TrustedHostMiddleware, Audit #18). Default ["*"] = aus. In PRODUKTION
# die echten Hostnamen als JSON-Liste setzen, z.B. ["ki.example.de"]. Defense-in-Depth zum Proxy.
ALLOWED_HOSTS=["*"]
# Vertrauenswürdige Reverse-Proxy-IPs für die Audit-IP-Ableitung (Audit #13). Nur wenn der direkte
# TCP-Peer hier gelistet ist, wird X-Forwarded-For ausgewertet. IPs oder CIDR als JSON-Liste.
TRUSTED_PROXIES=["127.0.0.1","::1"]
AUTH_CONFIG_PATH=config/auth.yaml
BUDGET_TIERS_PATH=config/budget_tiers.yaml
AUTH_ISERV_CLIENT_SECRET=   # nur in Produktion setzen
# Loggt beim Login die komplette SSO-userinfo (Diagnose von Rollen-/Gruppen-Mapping).
# Enthält Klarnamen/E-Mail → nur temporär aktivieren. Siehe docs/admin/konfiguration.md.
AUTH_DEBUG_USERINFO=false
PUBLIC_STUDENT_GRADES=[5,6,7,8,9,10,11,12]  # Jahrgangsstufen (Frontend + Backend)
PUBLIC_PERIODS=[1,2,3,4,5,6,7,8]  # Stundenraster der Schule (Wochenmuster-Editor); ausgelassene Stunden weglassen, z.B. [1,2,3,4,5,6,8]
SCHULART=GYM                 # Schulart dieser Schule (GYM, GMS, RS, HS …)
EXPORT_SCHOOL_NAME=          # Schulname in Curriculum-Exporten (PDF-Kopfzeile + YAML `schule`); leer → Wert aus Curriculum-Metadaten
PUBLIC_SCHOOL_NAME=ki@schule
PUBLIC_SCHOOL_LOGO_URL=          # Fallback für beide Themes; leer → Initialen-Kreis
PUBLIC_SCHOOL_LOGO_URL_LIGHT=   # Logo für helles Theme (überschreibt LOGO_URL)
PUBLIC_SCHOOL_LOGO_URL_DARK=    # Logo für dunkles Theme (überschreibt LOGO_URL)

# ── Stundenplan (WebUntis, UP-8) ──────────────────────────────────────────────
# Technisches Dienstkonto mit Leserecht auf die Stundenpläne. Leerer Server = keine
# Stundenplan-Integration; die zugehörigen Bedienelemente verschwinden dann einfach.
WEBUNTIS_SERVER=              # z. B. ggd.webuntis.com (mit oder ohne https://)
WEBUNTIS_USER=
WEBUNTIS_PASSWORD=
# NUR bei geteiltem Server nötig (Kürzel aus der Login-URL `?school=…`). Bei eigener
# Subdomain leer lassen — sonst antwortet WebUntis mit `invalid schoolname` (-8500).
WEBUNTIS_SCHOOL=

#!/bin/sh
#
# Führt vor jedem Commit scripts/test.sh aus (~35 s) und bricht bei Fehlern ab.
#
# Aktivieren (einmalig, pro Arbeitskopie):
#   git config core.hooksPath .githooks
#
# Bewusst umgehen — etwa für einen Commit, der nur Doku anfasst, oder wenn
# PostgreSQL gerade nicht läuft:
#   git commit --no-verify
#
# Der Hook prüft den Arbeitsbaum, nicht den Index. Wer nur einen Teil seiner
# Änderungen einbucht, testet hier trotzdem alles, was auf der Platte liegt.

exec "$(git rev-parse --show-toplevel)/scripts/test.sh"

#!/bin/sh
#
# Führt vor jedem Push scripts/test.sh aus (~45 s) und bricht bei Fehlern ab.
#
# Aktivieren (einmalig, pro Arbeitskopie):
#   git config core.hooksPath .githooks
#
# Bewusst umgehen:
#   git push --no-verify
#
# Warum pre-push und nicht pre-commit: Bei rund neun Commits am Tag (Spitzen über
# dreißig) kostet ein Lauf je Commit spürbar Zeit, ohne mehr zu schützen —
# ungepushter Code stört niemanden. Ein Push bündelt viele Commits, der Schutz
# bleibt derselbe.
#
# Der eigenständige Beitrag dieses Laufs sind die **Integrationstests**: Der
# GitHub-Workflow (.github/workflows/tests.yml) fährt bisher nur Frontend und
# Backend-Unit; tests/integration braucht dort einen pgvector-Dienst und fehlt noch.
# Steht diese Stufe, kann der Hook ersatzlos weg.
#
# Git reicht Remote-Name und URL als Argumente und die zu pushenden Refs über
# stdin herein (je Zeile: lokale Ref, lokaler SHA, entfernte Ref, entfernter SHA).
# Der Prüflauf selbst prüft den Arbeitsbaum; die Refs entscheiden nur, ob er läuft.
#
# Nur Tags (oder Löschungen) → kein Prüflauf (0.50): Der Commit hinter einem
# Release-Tag ist mit dem Branch schon gepusht und geprüft worden. `git push --tags`
# läuft damit ohne Prüflauf, `git push --follow-tags` mit Branch weiter mit.
# ⚠️ Nicht geprüft wird, ob der getaggte Commit schon auf dem Remote liegt — wer einen
# nie gepushten Commit taggt und nur den Tag pusht, pusht ungeprüft.

nur_tags=ja
while read -r lokal _ _ _; do
    case "$lokal" in
        refs/tags/*|"(delete)") ;;
        *) nur_tags=nein ;;
    esac
done
if [ "$nur_tags" = ja ]; then
    echo "pre-push: nur Tags — Prüflauf übersprungen."
    exit 0
fi

exec "$(git rev-parse --show-toplevel)/scripts/test.sh"
